{
  "manifest_version": 3,
  "name": "Die ABLAGE Webclipper",
  "version": "1.1.0",
  "description": "Artikel, Seiten und Links nach der Anmeldung erfassen und in Die ABLAGE prüfen.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Mit Die ABLAGE clippen",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
