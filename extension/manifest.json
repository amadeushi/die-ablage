{
  "manifest_version": 3,
  "name": "Die ABLAGE Webclipper",
  "version": "1.4.0",
  "description": "Artikel, ausgew\u00e4hlte Bereiche, Seiten und Links in Die ABLAGE pr\u00fcfen und speichern.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Mit Die ABLAGE clippen",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}