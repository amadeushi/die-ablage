{
  "manifest_version": 3,
  "name": "Die ABLAGE",
  "version": "0.2.0",
  "description": "Bereiche aus Safari in Die ABLAGE \u00fcbernehmen.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Mit Die ABLAGE clippen",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}